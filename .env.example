# Frontend (solo valores públicos)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA
VITE_API_URL=http://localhost:4000

# API (mantener secretos únicamente en servidor)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE_SECRETA
CORS_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development

# Asistente inteligente IDEALO SV
# Funciona con lógica interna del ERP y no requiere cuenta ni API key de OpenAI.

# Panel Maestro SaaS (solo servidor)
# Lista separada por comas de cuentas autorizadas para administrar todas las empresas.
IDEALO_PLATFORM_ADMIN_EMAILS=propietario@tuempresa.com

# Correo automático de facturas (solo servidor)
# Usar una contraseña de aplicación de Google, nunca la contraseña normal de Gmail.
GMAIL_SMTP_USER=tuempresa@gmail.com
GMAIL_APP_PASSWORD=TU_PASSWORD_DE_APLICACION_GOOGLE
GMAIL_FROM_NAME=IDEALO SV - Facturación

# DTE / Ministerio de Hacienda (solo servidor; iniciar siempre en test)
DTE_ENVIRONMENT=test
DTE_ENABLE_PRODUCTION=false
# Segunda llave deliberada. NO definir esta frase hasta autorizar formalmente el paso a producción.
DTE_PRODUCTION_APPROVAL=
DTE_MH_NIT=TU_NIT_SIN_GUIONES
DTE_MH_API_PASSWORD=TU_CLAVE_API_MH
DTE_SIGNER_URL=http://localhost:8113
DTE_SIGNER_TOKEN=GENERA_UN_TOKEN_ALEATORIO_DE_AL_MENOS_32_CARACTERES
DTE_SIGNER_PASSWORD=TU_CLAVE_PRIVADA_DEL_CERTIFICADO
DTE_REQUEST_TIMEOUT_MS=8000
DTE_MAX_RESENDS=2
